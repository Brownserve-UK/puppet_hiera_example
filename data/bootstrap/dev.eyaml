---
# This config is _only_ used when first bootstrapping a Puppetserver in the "dev" environment
# We can't use the regular hiera file as the "trusted" facts aren't available during a `puppet apply`
# This will get a Puppetserver bootstrapped when using the puppet-server.ps1 script from the puppet-bootstrap repo.
classes:
  - puppetserver
puppetserver::puppet_majorversion: 7
# Disable the management of the Puppet service on bootstrap
# if we don't disable this then theforeman/puppet will start the Puppet agent service this will trigger an
# immediate puppet run after the bootstrapping has completed that runs in the background, this is confusing
# at best and at worst it can lead to the server being provisioned incorrectly.
puppetserver::manage_agent_service: false

# Set the alt names that Puppet can respond to, this is important to do as part of the bootstrapping process as it can only be
# done during the initial CA set-up on the Puppetserver
puppetserver::dns_alt_names:
    - "%{::hostname}"
    - "puppetserver"
    - "puppetserver.%{::domain}"

# Manage our sources for r10k
# Replace the remote_path with your repository
puppetserver::codemanagement::sources:
  - source_name: 'example_repo'
    remote_path: 'git@github.com:Brownserve-UK/puppet_hiera_example.git'

# Don't install PuppetDB on the bootstrap environment as the certificates won't exist until we run 'puppet agent -t' for the first time
puppetserver::install_puppetdb: false
